(1,000 missing values generated)

. tempfile placebo_results

. save `placebo_results'
file /var/folders/lx/nd40flfd6t361qn7ryql0wn00000gn/T//S_27699.000004 saved as .dta format

. local n_perms = 1000

. set seed 12345

. forvalues i = 1/`n_perms' {
  2.     
.     * Load original data fresh each iteration
.     use `original_data', clear
  3.     
.     * Randomly assign one country as "fake treated"
.     gen random = runiform()
  4.     bysort country_id: egen country_rand = min(random)
  5.     egen rank = rank(country_rand)
  6.     gen fake_treated = (rank == 1)
  7.     gen fake_treated_post = fake_treated * (year >= 2021)
  8.     
.     * Run regression with fake treatment
.     quietly reghdfe ln_elec_price treated_post ln_gas_price ln_ren_elec ln_gas_elec ln_solidff_elec ln_gdp_pc ln_pop if inlist(country, "Croatia
> ", "Bulgaria", "Estonia", "Romania"), absorb(country_id year c.trend#i.country_id) cluster(country_id)
  9. 
.     
.     * Store placebo coefficient
.     local placebo_c = _b[fake_treated_post]
 10.     local placebo_se = _se[fake_treated_post]
 11.     local placebo_t_val = `placebo_c' / `placebo_se'
 12.     
.     * Update results file
.     use `placebo_results', clear
 13.     replace placebo_coef = `placebo_c' in `i'
 14.     replace placebo_t = `placebo_t_val' in `i'
 15.     quietly save `placebo_results', replace
 16.     
.     * Progress indicator
.     if mod(`i', 100) == 0 {
 17.         display "Completed " `i' " of " `n_perms' " permutations"
 18.     }
 19. }
